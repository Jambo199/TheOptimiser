<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>TheOptimiser</AssemblyName>
    <RootNamespace>TheOptimiser</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>..\..\assets\TheOptimiser.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- embed the catalog so a standalone single-file exe works; still copied to output for dev + a disk override -->
    <None Remove="catalog.json" />
    <EmbeddedResource Include="catalog.json" LogicalName="catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <!-- bake the splash logo into the exe (pack://application:,,,/assets/logo.png); the disk copy still overrides it -->
    <Resource Include="..\..\assets\logo.png" Link="assets\logo.png" />
  </ItemGroup>

</Project>
